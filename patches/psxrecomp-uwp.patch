+        { RECOMP_RUNTIME_UI_KEY_RESOLUTION_SCALE, "Display", "Internal resolution", "Higher values sharpen 3D graphics; applies next launch.", RECOMP_RUNTIME_UI_INT, 1, 4, 1, nullptr, 0, nullptr },
+        { kUwpAaKey, "Display", "Image smoothing", "Smooth the final game image.", RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { kUwpWideKey, "Display", "16:9 widescreen", "Expand the rendered playfield for widescreen TVs.", RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr },
+        { RECOMP_RUNTIME_UI_KEY_RESUME, "Display", "Resume game", "Return to Mega Man X4.", RECOMP_RUNTIME_UI_ACTION, 0, 0, 0, nullptr, 0, nullptr },
+    };
+    RecompRuntimeUiConfig config{};
+    config.title = "MEGA MAN X4 SETTINGS";
+    config.subtitle = "MENU + VIEW TO CLOSE";
+    config.items = settings_items;
+    config.item_count = sizeof(settings_items) / sizeof(settings_items[0]);
+    config.theme = "psx";
+    config.accept_label = "A SELECT";
+    config.back_label = "B CLOSE";
+    config.callbacks.get_value = uwp_settings_get;
+    config.callbacks.set_value = uwp_settings_set;
+    config.callbacks.run_action = uwp_settings_action;
