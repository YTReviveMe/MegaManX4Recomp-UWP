+static int uwp_settings_combo_down(void) {
+    SDL_GameController *controller = g_players[0].handle;
+    return controller &&
+        SDL_GameControllerGetButton(controller, SDL_CONTROLLER_BUTTON_BACK) &&
+        SDL_GameControllerGetButton(controller, SDL_CONTROLLER_BUTTON_START);
+}
+
+static void uwp_settings_poll_toggle_buttons(void) {
+    static int was_down;
+    const int down = uwp_settings_combo_down();
+    if (down && !was_down && !savestate_menu_open && !psx_rewind_is_open()) {
+        uwp_settings_ensure();
+        if (g_uwp_settings_ui) {
+            recomp_runtime_ui_open(g_uwp_settings_ui);
+            recomp_runtime_ui_enter_section(g_uwp_settings_ui, 0);
+        }
+    }
+    was_down = down;
+}
+
+static void uwp_settings_host_pause_loop(void) {
+    int previous[5] = {};
+    uint32_t repeated_at[4] = {};
+    int combo_armed = 0;
+    gl_renderer_set_interpolation_suspended(1);
+    while (g_uwp_settings_ui && recomp_runtime_ui_is_open(g_uwp_settings_ui)) {
+        SDL_Event event;
+        while (SDL_PollEvent(&event)) {
+            if (event.type == SDL_QUIT) {
+                psx_crash_trace_set_exit_origin("sdl_window_close");
+                shutdown_runtime();
+                std::exit(0);
+            }
+        }
+        SDL_GameControllerUpdate();
+        SDL_GameController *controller = g_players[0].handle;
+        const int combo_down = uwp_settings_combo_down();
+        if (!combo_down) combo_armed = 1;
+        if (combo_down && combo_armed) {
+            recomp_runtime_ui_close(g_uwp_settings_ui);
+            break;
+        }
+
+        int current[5] = {};
+        if (controller) {
+            const Sint16 left_x = SDL_GameControllerGetAxis(controller, SDL_CONTROLLER_AXIS_LEFTX);
+            const Sint16 left_y = SDL_GameControllerGetAxis(controller, SDL_CONTROLLER_AXIS_LEFTY);
+            const int dead_zone = 16000;
+            current[0] = SDL_GameControllerGetButton(controller, SDL_CONTROLLER_BUTTON_DPAD_UP) ||
+                left_y < -dead_zone;
+            current[1] = SDL_GameControllerGetButton(controller, SDL_CONTROLLER_BUTTON_DPAD_DOWN) ||
+                left_y > dead_zone;
+            current[2] = SDL_GameControllerGetButton(controller, SDL_CONTROLLER_BUTTON_DPAD_LEFT) ||
+                left_x < -dead_zone;
+            current[3] = SDL_GameControllerGetButton(controller, SDL_CONTROLLER_BUTTON_DPAD_RIGHT) ||
+                left_x > dead_zone;
+            current[4] = SDL_GameControllerGetButton(controller, SDL_CONTROLLER_BUTTON_A);
+            if (SDL_GameControllerGetButton(controller, SDL_CONTROLLER_BUTTON_B)) {
+                recomp_runtime_ui_close(g_uwp_settings_ui);
+                break;
+            }
+        }
+        const uint32_t ticks = (uint32_t)SDL_GetTicks();
+        const RecompRuntimeUiInput inputs[5] = {
+            RECOMP_RUNTIME_UI_INPUT_UP, RECOMP_RUNTIME_UI_INPUT_DOWN,
+            RECOMP_RUNTIME_UI_INPUT_LEFT, RECOMP_RUNTIME_UI_INPUT_RIGHT,
+            RECOMP_RUNTIME_UI_INPUT_ACCEPT
+        };
+        for (int index = 0; index < 5; ++index) {
+            const int edge = current[index] && !previous[index];
+            const int repeat = index < 4 && current[index] && previous[index] &&
+                (int32_t)(ticks - repeated_at[index]) >= 170;
+            if (edge || repeat) {
+                recomp_runtime_ui_handle_input(g_uwp_settings_ui, inputs[index], 1, repeat);
+                repeated_at[index] = ticks;
+            }
+            previous[index] = current[index];
+        }
+        rewind_pause_present();
+        starvation_watchdog_heartbeat();
+        SDL_Delay(8);
+    }
+    gl_renderer_set_interpolation_suspended(0);
+    savestate_input_guard_arm();
+}
+#endif
+
